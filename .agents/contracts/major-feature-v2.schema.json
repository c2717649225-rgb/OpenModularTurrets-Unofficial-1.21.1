{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex:neoforge:major-feature-contract:2",
  "title": "NeoForge 1.21.1 Major Feature Contract v2 (Provisional Core)",
  "description": "The v1 behavioral contract plus atomic acceptance criteria, risk classification, executable test references and a versioned design source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "design_source",
    "review_required",
    "id",
    "version",
    "status",
    "summary",
    "server_authority",
    "persistence",
    "network",
    "client_boundary",
    "registries",
    "assets",
    "performance",
    "dependencies",
    "acceptance"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "design_source": {
      "$ref": "#/$defs/designSource"
    },
    "review_required": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewItem"
      },
      "uniqueItems": true
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "implementing",
        "verifying",
        "released",
        "deprecated"
      ]
    },
    "summary": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "server_authority": {
      "$ref": "#/$defs/serverAuthority"
    },
    "persistence": {
      "$ref": "#/$defs/persistence"
    },
    "network": {
      "$ref": "#/$defs/network"
    },
    "client_boundary": {
      "$ref": "#/$defs/clientBoundary"
    },
    "registries": {
      "$ref": "#/$defs/registries"
    },
    "assets": {
      "$ref": "#/$defs/assets"
    },
    "performance": {
      "$ref": "#/$defs/performance"
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "resourceLocation": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[^\\\\]+$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "idList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "designSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "revision",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_value": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "serverAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "authoritative_state",
        "client_input_policy",
        "invalid_input_policy"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "enum": [
            "logical_server",
            "client_cosmetic_only"
          ]
        },
        "authoritative_state": {
          "$ref": "#/$defs/stringList"
        },
        "client_input_policy": {
          "type": "string",
          "enum": [
            "not_applicable",
            "intent_only",
            "read_only"
          ]
        },
        "invalid_input_policy": {
          "type": "string",
          "enum": [
            "not_applicable",
            "reject",
            "reject_and_log",
            "disconnect_on_abuse"
          ]
        }
      }
    },
    "persistenceSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "format",
        "owner",
        "fields"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "type": "string",
          "enum": [
            "none",
            "codec",
            "value_io",
            "data_component",
            "attachment",
            "saved_data"
          ]
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fields": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "supported_from",
        "fallback",
        "test_ids"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "none",
            "versioned_codec",
            "datafixer_upper",
            "custom"
          ]
        },
        "supported_from": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "fallback": {
          "type": "string",
          "enum": [
            "not_applicable",
            "fail_load",
            "backup_and_reset",
            "reject_incompatible"
          ]
        },
        "test_ids": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "scope",
        "schema",
        "migration"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "enum": [
            "none",
            "item_stack",
            "entity",
            "player",
            "block_entity",
            "chunk",
            "level",
            "server"
          ]
        },
        "schema": {
          "$ref": "#/$defs/persistenceSchema"
        },
        "migration": {
          "$ref": "#/$defs/migration"
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "max_per_second",
        "burst",
        "key"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "none",
            "cooldown",
            "fixed_window",
            "token_bucket",
            "coalesced"
          ]
        },
        "max_per_second": {
          "type": "number",
          "minimum": 0
        },
        "burst": {
          "type": "integer",
          "minimum": 0
        },
        "key": {
          "type": "string",
          "enum": [
            "not_applicable",
            "player",
            "connection",
            "dimension",
            "global"
          ]
        }
      }
    },
    "networkFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "direction",
        "purpose",
        "validation",
        "rate_limit",
        "max_payload_bytes",
        "test_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "direction": {
          "type": "string",
          "enum": [
            "c2s",
            "s2c"
          ]
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "validation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rate_limit": {
          "$ref": "#/$defs/rateLimit"
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "test_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "flows"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/networkFlow"
          }
        }
      }
    },
    "clientBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common_code_client_imports",
        "client_only_packages",
        "visual_state",
        "dedicated_server_fallback",
        "dedicated_server_test_id"
      ],
      "properties": {
        "common_code_client_imports": {
          "type": "string",
          "enum": [
            "forbidden"
          ]
        },
        "client_only_packages": {
          "$ref": "#/$defs/stringList"
        },
        "visual_state": {
          "type": "string",
          "enum": [
            "not_applicable",
            "synced_server_state",
            "local_cosmetic_state"
          ]
        },
        "dedicated_server_fallback": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dedicated_server_test_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "registryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "ids",
        "lifecycle"
      ],
      "properties": {
        "registry": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceLocation"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "static",
            "datapack"
          ]
        }
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "tags"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registryEntry"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceLocation"
          },
          "uniqueItems": true
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated",
        "manual",
        "locales",
        "license_review",
        "validation_test_ids"
      ],
      "properties": {
        "generated": {
          "$ref": "#/$defs/stringList"
        },
        "manual": {
          "$ref": "#/$defs/stringList"
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}_[a-z]{2}$"
          },
          "uniqueItems": true
        },
        "license_review": {
          "type": "string",
          "enum": [
            "not_applicable",
            "pending",
            "complete"
          ]
        },
        "validation_test_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "performanceBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metric",
        "scope",
        "limit",
        "unit",
        "measurement",
        "test_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "metric": {
          "type": "string",
          "enum": [
            "server_tick_time",
            "client_frame_time",
            "allocation_rate",
            "network_rate",
            "worldgen_time",
            "memory",
            "entity_count",
            "custom"
          ]
        },
        "scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "limit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "ms_per_tick",
            "ms_per_frame",
            "bytes_per_second",
            "bytes_per_tick",
            "allocations_per_tick",
            "ms_per_chunk",
            "mib",
            "count",
            "custom"
          ]
        },
        "measurement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "test_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budgets",
        "hot_paths",
        "measurement_environment"
      ],
      "properties": {
        "budgets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/performanceBudget"
          },
          "minItems": 1
        },
        "hot_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "measurement_environment": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "modDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "version_range",
        "fallback"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "requirement": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "incompatible"
          ]
        },
        "version_range": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fallback": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features",
        "mods"
      ],
      "properties": {
        "features": {
          "$ref": "#/$defs/idList"
        },
        "mods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modDependency"
          }
        }
      }
    },
    "executableTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "command",
        "covers",
        "required",
        "expected",
        "timeout_seconds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "unit",
            "gametest",
            "integration",
            "dedicated_server",
            "client_smoke",
            "migration",
            "performance",
            "static",
            "datagen"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1
        },
        "test_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_$][A-Za-z0-9_.$]*#[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "covers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        },
        "expected": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "risk",
        "required",
        "statement",
        "observation",
        "test_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "risk": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "unclassified"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "observation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "test_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "manualCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "steps",
        "expected"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1
        },
        "expected": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "tests",
        "manual_checks",
        "non_goals"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptanceCriterion"
          },
          "minItems": 1
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executableTest"
          },
          "minItems": 1
        },
        "manual_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manualCheck"
          },
          "minItems": 1
        },
        "non_goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex:neoforge:execution-policy:provisional-1",
  "title": "Autonomous Flagship Studio provisional core execution policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stability",
    "policy_id",
    "backend",
    "writable_paths",
    "timeout_seconds",
    "required_capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "stability": {
      "type": "string",
      "enum": [
        "provisional"
      ]
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "backend": {
      "type": "string",
      "enum": [
        "bubblewrap"
      ]
    },
    "writable_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 7200
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "filesystem_read_only",
          "workspace_write_allowlist",
          "network_denied",
          "process_timeout",
          "process_tree_cleanup",
          "evidence_unmounted"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex:neoforge:studio:evidence:provisional:1",
  "title": "Autonomous Mod Studio Evidence Ledger (Provisional v1)",
  "description": "Provisional schema for one authoritative journal event or sealed run evidence bundle. The trusted writer additionally enforces a hard 10 MiB combined journal+bundle budget; large logs and artifacts are digest references, never embedded payloads.",
  "oneOf": [
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/bundle"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "transitionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "TIMEOUT",
        "VERIFIED_INFRA_ERROR"
      ]
    },
    "digestBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_tree_digest",
        "control_digest",
        "input_digest",
        "policy_digest"
      ],
      "properties": {
        "host_tree_digest": {
          "$ref": "#/$defs/digest"
        },
        "control_digest": {
          "$ref": "#/$defs/digest"
        },
        "input_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "pathEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "kind",
        "exists",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "directory",
            "symlink",
            "missing",
            "unreadable"
          ]
        },
        "exists": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "startedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "host_workspace",
        "digests",
        "report_staging",
        "declared_reports",
        "declared_artifacts"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "host_workspace": {
          "type": "string",
          "minLength": 1
        },
        "digests": {
          "$ref": "#/$defs/digestBindings"
        },
        "report_staging": {
          "const": "non_authoritative"
        },
        "declared_reports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "declared_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "sealedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "duration_seconds",
        "exit_code",
        "timed_out",
        "interrupted",
        "reports",
        "artifacts",
        "details"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "interrupted": {
          "type": "boolean"
        },
        "reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathEvidence"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathEvidence"
          }
        },
        "details": {
          "type": "object"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "stability",
        "run_id",
        "sequence",
        "transition_id",
        "event_type",
        "recorded_at_utc",
        "previous_event_digest",
        "payload",
        "event_digest"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "stability": {
          "const": "provisional"
        },
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "transition_id": {
          "$ref": "#/$defs/transitionId"
        },
        "event_type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "recorded_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "previous_event_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "type": "object"
        },
        "event_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "RUN_STARTED"
              }
            },
            "required": [
              "event_type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/startedPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "RUN_SEALED"
              }
            },
            "required": [
              "event_type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/sealedPayload"
              }
            }
          }
        }
      ]
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "stability",
        "kind",
        "run_id",
        "outcome",
        "sealed_at_utc",
        "event_count",
        "journal_head_digest",
        "journal_sha256",
        "terminal_transition_id",
        "terminal_event_digest",
        "summary",
        "bundle_digest"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "stability": {
          "const": "provisional"
        },
        "kind": {
          "const": "run_evidence_bundle"
        },
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "sealed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "event_count": {
          "type": "integer",
          "minimum": 2
        },
        "journal_head_digest": {
          "$ref": "#/$defs/digest"
        },
        "journal_sha256": {
          "$ref": "#/$defs/digest"
        },
        "terminal_transition_id": {
          "$ref": "#/$defs/transitionId"
        },
        "terminal_event_digest": {
          "$ref": "#/$defs/digest"
        },
        "summary": {
          "$ref": "#/$defs/sealedPayload"
        },
        "bundle_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}

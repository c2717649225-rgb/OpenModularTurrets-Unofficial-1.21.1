{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex:neoforge:mod-studio:1",
  "title": "Autonomous Flagship Studio Manifest (Provisional Core)",
  "description": "Portable, model-agnostic project inputs for the v1.3 evidence spine. Future capability packs extend this core only after their trigger is approved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "project_id",
    "versions",
    "design_sources",
    "approved_assets",
    "enabled_packs"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "versions": {
      "$ref": "#/$defs/versions"
    },
    "design_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contentSource"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "approved_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contentSource"
      },
      "uniqueItems": true
    },
    "enabled_packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pack"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[^\\\\]+$"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minecraft",
        "neoforge",
        "java",
        "gradle"
      ],
      "properties": {
        "minecraft": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "neoforge": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "java": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "gradle": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "contentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

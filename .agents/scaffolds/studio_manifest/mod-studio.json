{
  "$schema": "../../.agents/studio/schemas/mod-studio.schema.json",
  "schema_version": 1,
  "project_id": "{{PROJECT_ID}}",
  "versions": {
    "minecraft": "1.21.1",
    "neoforge": "{{EXACT_NEOFORGE_VERSION}}",
    "java": "{{JAVA_VERSION}}",
    "gradle": "{{GRADLE_VERSION}}"
  },
  "design_sources": [
    {
      "path": "docs/design/{{VERSIONED_DESIGN_FILE}}",
      "sha256": "{{LOWERCASE_SHA256}}"
    }
  ],
  "approved_assets": [
    {
      "path": "src/main/resources/assets/{{MODID}}/{{APPROVED_ASSET_PATH}}",
      "sha256": "{{LOWERCASE_SHA256}}"
    }
  ],
  "enabled_packs": []
}
